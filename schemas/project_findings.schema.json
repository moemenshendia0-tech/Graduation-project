{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/project-findings-v1.schema.json",
  "title": "Project-generated Network Finding",
  "type": "object",
  "required": ["timestamp_utc", "source_tool", "alert_origin", "detection_engine", "rule_id", "severity", "confidence", "title", "evidence", "evidence_refs", "related_events"],
  "properties": {
    "timestamp_utc": {"type": "string"},
    "first_seen_utc": {"type": "string"},
    "last_seen_utc": {"type": "string"},
    "source_tool": {"const": "ProjectDetector"},
    "alert_origin": {"const": "project_generated"},
    "detection_engine": {"const": "project-network-findings"},
    "rule_id": {"type": "string", "pattern": "^NET-(007|008|009|010|011|012)$"},
    "severity": {"enum": ["low", "medium"]},
    "confidence": {"enum": ["low", "medium"]},
    "title": {"type": "string", "minLength": 1},
    "src_ip": {"type": "string"},
    "dst_ip": {"type": "string"},
    "src_port": {"type": ["integer", "null"]},
    "dst_port": {"type": ["integer", "null"]},
    "protocol": {"type": "string"},
    "uid": {"type": "string"},
    "evidence": {"type": "string", "minLength": 2},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "related_events": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
